<!DOCTYPE html>
<html>
<head>

<title> car showroom </title>

<style>
    body{
        margin:0;
    }

    .background{
        position: fixed;
        top:0;
        left:0;
        width:100%;
        height:100%;
        object-fit:cover;
        z-index:-1;
    }

    .image{
        display:flex;
        flex-direction: column;
        justify-content:center;
        align-items: center;
        height:100vh;
    }

    .card{
        position:relative;
        width:300px;
        height:380px;
        border-radius:15px;
        box-shadow: 0 0 50px black;
        overflow: hidden;
    }

    .card img{
        width:100%;
        height:100%;
        object-fit:cover;
    }

    .overlay{
        position:absolute;
        bottom:0;
        width:100%;
        text-align:center;
        color:white;
    }

    .overlay h2, .overlay p{
        margin:4px;
    }

    .buttons{
        display:flex;
        justify-content:center;
        gap:8px;
        margin-top:12px;
    }

    .buttons a{
        padding:8px 14px;
        background:red;
        color:white;
        text-decoration:none;
        border-radius:20px;
        font-size:14px;
    }

    .buttons a:hover{
        background:darkred;
    }

    .links{
        font-size:14px;
    }

    .links a{
        color:white;
        margin:0 6px;
    }
</style>

</head>
<body>
    <video class="background" autoplay muted loop playsinline>
        <source src="/storage/emulated/0/heet123/practical practice.html/all files/bg.mp4" type="video/mp4">
    </video>

<div class="image">

    <div class="card">
        <img src="/storage/emulated/0/heet123/practical practice.html/all files/IMG_20261019_203224.jpg" alt="BMW Car">

        <div class="overlay">
            <h2>BMW M4</h2>
            <p>Power. Speed. Style.</p>

            <div class="buttons">
                <a href="#">Buy Now</a>
                <a href="#">Details</a>
                <a href="#">Contact</a>
            </div>

            <div class="links">
                <a href="#">Gallery</a> |
                <a href="#">About Us</a>
            </div>
        </div>
    </div>

</div>

</body>
</html>